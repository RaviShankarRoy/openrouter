{
  "name": "@openrouter/cli",
  "version": "0.1.0",
  "description": "Official CLI for the OpenRouter-equivalent AI gateway. Login, list models, chat, manage keys and view usage.",
  "type": "module",
  "bin": {
    "openrouter": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage .tsup",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "openrouter",
    "ai",
    "llm",
    "cli",
    "openai",
    "anthropic",
    "gateway"
  ],
  "author": "OpenRouter Engineering",
  "license": "Apache-2.0",
  "homepage": "https://openrouter.example.com/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/openrouter-example/openrouter.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/openrouter-example/openrouter/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "asciichart": "^1.5.25",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "undici": "^6.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "msw": "^2.7.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
