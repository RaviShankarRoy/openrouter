# Copy to .env for local dev. Production values come from Vault → k8s Secret.

# ---------- Common ----------
ENVIRONMENT=dev                  # dev | staging | prod
LOG_LEVEL=info                   # debug | info | warn | error
SERVICE_VERSION=0.1.0

# ---------- Postgres (Python only) ----------
POSTGRES_DSN=postgresql+asyncpg://openrouter:dev_only_password@localhost:5432/openrouter
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=20

# ---------- Redis (Go + Python) ----------
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

# ---------- NATS ----------
NATS_URL=nats://localhost:4222
NATS_STREAM=GATEWAY_EVENTS

# ---------- S3 / Minio ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=openrouter
S3_SECRET_KEY=dev_only_password
S3_BUCKET=openrouter-media
S3_REGION=us-east-1

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=gateway-go     # overridden per service
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.01
PROMETHEUS_PORT=9090

# ---------- Gateway (Go) ----------
GATEWAY_HTTP_PORT=8080
GATEWAY_METRICS_PORT=9091
GATEWAY_BACKEND_GRPC=localhost:50051
GATEWAY_AUTH_CACHE_TTL_SECONDS=60
GATEWAY_AUTH_CACHE_SIZE=10000
GATEWAY_PROVIDER_CONFIG=./gateway-go/configs/providers.yaml

# ---------- Backend (Python) ----------
BACKEND_HTTP_PORT=8000
BACKEND_GRPC_PORT=50051
BACKEND_METRICS_PORT=9092
SECRET_KEY=dev_only_change_in_prod_min_32_chars_long
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KB=65536
ARGON2_PARALLELISM=4

# ---------- Stripe (Python) ----------
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------- Provider keys (consumed by both Go gateway and Python backend) ----------
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me
GOOGLE_API_KEY=replace-me
# OpenAI-compatible aggregators (Gemma 4, Qwen 3.x, Llama, etc.)
TOGETHER_API_KEY=replace-me
FIREWORKS_API_KEY=replace-me
# Self-host (Ollama ignores the key; any non-empty value is fine)
OLLAMA_API_KEY=ollama
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1

# ---------- Frontend (TypeScript) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev_only_change_in_prod
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
