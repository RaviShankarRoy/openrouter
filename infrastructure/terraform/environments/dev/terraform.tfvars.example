region       = "us-east-1"
environment  = "dev"
cluster_name = "openrouter-dev"

# Bump these for sustained load tests.
node_min_size       = 2
node_max_size       = 6
node_instance_types = ["t3.large"]

rds_instance_class = "db.t4g.medium"
redis_node_type    = "cache.t4g.small"

common_tags = {
  Owner = "platform"
  CostCenter = "engineering-platform"
}
