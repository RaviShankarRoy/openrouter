# deploy/aws/.env.aws.example
# Copy to the REPO ROOT as `.env.aws` on the EC2 instance, then fill in values:
#
#   cp deploy/aws/.env.aws.example .env.aws
#   nano .env.aws
#
# Generate strong secrets with:   openssl rand -hex 32
# NEVER commit .env.aws to git (it's covered by .gitignore's .env* pattern —
# verify with: git check-ignore .env.aws).

# ---------- Your domain ----------
# You need a domain with two DNS A records pointing at the server's Elastic IP:
#   api.<your-domain>  and  app.<your-domain>
DOMAIN=example.com
ACME_EMAIL=you@example.com          # Let's Encrypt sends expiry warnings here

# ---------- Secrets (generate each with: openssl rand -hex 32) ----------
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---------- General ----------
ENVIRONMENT=prod
LOG_LEVEL=info

# Tracing is off by default here (no OTel collector on this single box).
OTEL_TRACES_SAMPLER=always_off

# ---------- LLM provider keys (fill in the ones you actually use) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# ---------- OAuth login (Google/GitHub) — optional at first ----------
# Create OAuth apps with callback URL: https://app.<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Stripe (optional until you enable billing) ----------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
