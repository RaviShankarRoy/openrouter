# Frontend env vars. Copy to .env.local for dev. Production values come from
# k8s Secret + ConfigMap. NEXT_PUBLIC_* keys are inlined into the client bundle —
# never put secrets behind that prefix.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SERVICE_VERSION=0.1.0
NEXT_PUBLIC_ENVIRONMENT=dev

# Auth.js (next-auth v5)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev_only_change_in_prod
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Stripe (publishable key only client-side; secret stays server-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# OpenTelemetry — exported via @vercel/otel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=frontend-web

# Logging
LOG_LEVEL=info
