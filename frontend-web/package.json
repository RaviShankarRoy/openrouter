{
  "name": "@openrouter/frontend-web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 15 dashboard, playground, and marketing site for the OpenRouter-equivalent AI gateway. DRD Module 3 (FE-001..FE-015).",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "codegen:openapi": "openapi-typescript ../shared/openapi/openapi.yaml -o src/repository/generated/schema.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "1.0.14",
    "@ai-sdk/react": "1.0.7",
    "@auth/core": "0.37.4",
    "@hookform/resolvers": "3.9.1",
    "@monaco-editor/react": "4.6.0",
    "@opentelemetry/api-logs": "^0.215.0",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-tooltip": "1.1.6",
    "@stripe/react-stripe-js": "3.1.1",
    "@stripe/stripe-js": "5.4.0",
    "@tanstack/react-query": "5.62.7",
    "@tanstack/react-query-devtools": "5.62.7",
    "@vercel/otel": "1.10.1",
    "ai": "4.0.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.25",
    "next-mdx-remote": "5.0.0",
    "next-themes": "0.4.4",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.54.2",
    "recharts": "2.15.0",
    "sonner": "1.7.1",
    "tailwind-merge": "2.5.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@tailwindcss/postcss": "4.0.0-beta.8",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "eslint-config-prettier": "9.1.0",
    "happy-dom": "15.11.7",
    "openapi-typescript": "7.4.4",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tailwindcss": "4.0.0-beta.8",
    "typescript": "5.7.2",
